<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create-fox-sequence" author="mate">
        <createSequence sequenceName="FOX_SEQ" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="002-create-fox-table" author="mate">
        <createTable tableName="FOX">
            <column name="ID" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="SPECIES" type="VARCHAR(255)"/>
            <column name="GENDER" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="IMAGE" type="VARCHAR(1000)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>